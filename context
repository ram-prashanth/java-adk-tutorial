private static final String USER_ID_PREFIX = "A2A_USER_";

@Override
public Maybe<Session> getSession(
    String appName, String userId, String sessionId, Optional<GetSessionConfig> cfg) {
  return delegate.getSession(appName, userId, sessionId, cfg)
      .map(session -> merge(session, sessionId));   // sessionId == contextId
}

@Override
public Single<Session> createSession(String appName, String userId) {
  String contextId = userId.startsWith(USER_ID_PREFIX)
      ? userId.substring(USER_ID_PREFIX.length())
      : userId;
  // ... your existing logic that forces session id == contextId ...
  return delegate.createSession(appName, userId, /* state */ null, Optional.of(contextId))
      .map(session -> merge(session, contextId));
}

private static Session merge(Session session, String contextId) {
  Map<String, String> headers = RequestHeaderHolder.get(contextId);
  if (!headers.isEmpty()) {
    session.state().put(RequestHeaderHolder.STATE_KEY, new HashMap<>(headers));
  }
  return session;
}

