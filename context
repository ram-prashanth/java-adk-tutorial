import java.util.Map;
import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.ConcurrentMap;

public final class RequestHeaderHolder {
  public static final String STATE_KEY = "auth_headers";

  // keyed by A2A contextId == the sessionId passed to getSession
  private static final ConcurrentMap<String, Map<String, String>> BY_CONTEXT =
      new ConcurrentHashMap<>();

  private RequestHeaderHolder() {}

  public static void put(String contextId, Map<String, String> headers) {
    if (contextId != null && headers != null && !headers.isEmpty()) {
      BY_CONTEXT.put(contextId, headers);
    }
  }

  public static Map<String, String> get(String contextId) {
    return BY_CONTEXT.getOrDefault(contextId, Map.of());
  }

  public static void remove(String contextId) {
    BY_CONTEXT.remove(contextId);
  }
}

